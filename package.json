{
  "name": "brainsync-focus-timer",
  "displayName": "BrainSync Focus Timer",
  "description": "%description%",
  "version": "0.1.7",
  "publisher": "donut-service",
  "author": {
    "name": "Donut Service",
    "email": "contact@donut-service.com",
    "url": "https://donut-service.com"
  },
  "icon": "resources/icons/brainsync-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiTachi/brainsync-pomodoro-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/YukiTachi/brainsync-pomodoro-vscode-extension/issues"
  },
  "homepage": "https://donut-service.com",
  "engines": {
    "vscode": "^1.80.0"
  },
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pomodoro",
    "timer",
    "productivity",
    "focus",
    "brainsync",
    "brain health",
    "cognitive wellness",
    "時間管理",
    "脳疲労",
    "集中力",
    "brain fatigue",
    "burnout",
    "wellness",
    "deep work",
    "break reminder"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "brainsync.startTimer",
        "title": "%command.startTimer%"
      },
      {
        "command": "brainsync.pauseTimer",
        "title": "%command.pauseTimer%"
      },
      {
        "command": "brainsync.resetTimer",
        "title": "%command.resetTimer%"
      },
      {
        "command": "brainsync.skipBreak",
        "title": "%command.skipBreak%"
      },
      {
        "command": "brainsync.viewStats",
        "title": "%command.viewStats%"
      },
      {
        "command": "brainsync.openDiagnosis",
        "title": "%command.openDiagnosis%"
      },
      {
        "command": "brainsync.exportData",
        "title": "%command.exportData%"
      },
      {
        "command": "brainsync.resetStats",
        "title": "%command.resetStats%"
      },
      {
        "command": "brainsync.settings",
        "title": "%command.settings%"
      },
      {
        "command": "brainsync.disableDnd",
        "title": "%command.disableDnd%"
      },
      {
        "command": "brainsync.connectSlack",
        "title": "%command.connectSlack%"
      },
      {
        "command": "brainsync.disconnectSlack",
        "title": "%command.disconnectSlack%"
      }
    ],
    "configuration": {
      "title": "BrainSync Focus Timer",
      "properties": {
        "brainsync.workDuration": {
          "type": "number",
          "default": 30,
          "minimum": 15,
          "maximum": 60,
          "description": "%config.workDuration%"
        },
        "brainsync.shortBreak": {
          "type": "number",
          "default": 5,
          "minimum": 3,
          "maximum": 10,
          "description": "%config.shortBreak%"
        },
        "brainsync.longBreak": {
          "type": "number",
          "default": 15,
          "minimum": 10,
          "maximum": 30,
          "description": "%config.longBreak%"
        },
        "brainsync.longBreakInterval": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 8,
          "description": "%config.longBreakInterval%"
        },
        "brainsync.autoStartBreak": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStartBreak%"
        },
        "brainsync.autoStartWork": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStartWork%"
        },
        "brainsync.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.soundEnabled%"
        },
        "brainsync.notificationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.notificationEnabled%"
        },
        "brainsync.soundVolume": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.soundVolume%"
        },
        "brainsync.soundFile": {
          "type": "string",
          "enum": [
            "bell",
            "chime",
            "silent"
          ],
          "default": "bell",
          "description": "%config.soundFile%"
        },
        "brainsync.fatigueAlertEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.fatigueAlertEnabled%"
        },
        "brainsync.fatigueAlertThreshold": {
          "type": "number",
          "default": 21,
          "minimum": 15,
          "maximum": 30,
          "description": "%config.fatigueAlertThreshold%"
        },
        "brainsync.focusDoNotDisturb": {
          "type": "boolean",
          "default": false,
          "description": "%config.focusDoNotDisturb%"
        },
        "brainsync.slackIntegration": {
          "type": "boolean",
          "default": false,
          "description": "%config.slackIntegration%"
        },
        "brainsync.slackSetStatus": {
          "type": "boolean",
          "default": true,
          "description": "%config.slackSetStatus%"
        },
        "brainsync.slackStatusText": {
          "type": "string",
          "default": "集中中",
          "description": "%config.slackStatusText%"
        },
        "brainsync.slackStatusEmoji": {
          "type": "string",
          "default": ":tomato:",
          "description": "%config.slackStatusEmoji%"
        },
        "brainsync.fatigueForecastEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.fatigueForecastEnabled%"
        },
        "brainsync.fatigueForecastLookahead": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "%config.fatigueForecastLookahead%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && node ./out/test/unit/runUnitTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.57.0",
    "glob": "^13.0.2",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
